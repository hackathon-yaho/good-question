# 이 파일을 복사해 .env 로 저장한 뒤 값을 채우세요.
# .env는 git에 올라가지 않습니다. 실제 비밀값을 이 파일(.env.example)에 넣지 마세요.
#
# 전체 항목의 근거·결정 배경은 docs/setup.md 를 참조하세요.
# 아래는 Phase별로 실제 코드가 사용하는 시점에 맞춰 그룹핑했습니다.

# ── DB (Phase 1 — 지금 사용) ───────────────────────────────────────────────
# 로컬: docker-compose.yml 의 db 서비스 기본값과 동일합니다.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/goodquestion
SPRING_DATASOURCE_USERNAME=gq
SPRING_DATASOURCE_PASSWORD=gq

# 개발: update / 운영: validate
JPA_DDL_AUTO=update

# ── 인증 (Phase 2 — 지금 사용) ──────────────────────────────────────────────
# 카카오 개발자 콘솔에서 발급. https://developers.kakao.com
# Redirect URI 등록값: {서버주소}/api/login/oauth2/code/kakao (context-path가 /api라 붙는다)
KAKAO_CLIENT_ID=
# Client Secret을 발급·활성화하지 않았다면 비워둬도 되나, 로그인이 invalid_client로 실패할 수 있다.
KAKAO_CLIENT_SECRET=

# 32자(바이트) 이상. 예: openssl rand -base64 32
JWT_SECRET=
# 기본 7일(604800000ms). 시연 중 만료를 피하려 넉넉히 잡음
JWT_ACCESS_VALIDITY=604800000

# 로그인 성공/실패 후 리다이렉트할 프론트 주소 (뒤에 /auth/callback이 붙는다)
FRONTEND_URL=http://localhost:3000
# 로컬(http) false / 배포(https) true — SameSite 쿠키 정책이 여기에 따라 갈린다 (decisions.md 참조)
COOKIE_SECURE=false

# ── AI 서버 연동 (Phase 4 — 아직 코드에서 사용하지 않음) ───────────────────
# AI_SERVER_BASE_URL=
# AI_SERVER_INTERNAL_TOKEN=

# ── STT/TTS (Phase 5 — 아직 코드에서 사용하지 않음) ────────────────────────
# 백엔드 전용 키입니다. gpt-5-mini 호출용 키(AI 서버)와 다릅니다 (decisions.md D-16).
# OPENAI_API_KEY=

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
