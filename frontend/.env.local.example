# 백엔드 오리진. 배포에서는 Render 주소로 바꾼다.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# 데이터·인증을 실서버로 붙일지 목으로 둘지.
#   mock    (기본) — 목 데이터. 백엔드 없이 동작. npm run verify가 이 모드로 돈다
#   backend        — 실서버 호출. 카카오 리다이렉트 + JWT 쿠키 포함
#
# 인증과 데이터는 함께 켜지고 함께 꺼진다. 섞으면 깨진다 —
# 목 데이터는 자체 childId를 쓰는데 실서버는 그런 아이를 모른다.
#
# backend 모드에서 카카오 앱 등록 전이면 로그인 화면의
# "카카오 없이 로그인 (dev-login)"으로 흐름을 검증할 수 있다.
# 개발 중에는 재시작 없이 주소에 ?api=backend 를 붙여도 된다.
NEXT_PUBLIC_API_MODE=mock

# 음성 처리를 브라우저에서 할지 백엔드에서 할지.
#   mock    (기본) — 브라우저 Web Speech API. 노트북 Chrome에서 지금 들린다
#   backend        — MediaRecorder + POST /api/stt + GET /api/tts. iPad 안전
#
# 백엔드가 두 엔드포인트를 올리면 backend로 바꾼다.
# 개발 중에는 재시작 없이 ?speech=backend 를 주소에 붙여도 된다.
NEXT_PUBLIC_SPEECH_MODE=mock
